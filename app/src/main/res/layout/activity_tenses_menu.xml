<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_back"
        app:title="Tense"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_a_tense"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"/>

    <!-- Tense Introduction Button -->
    <Button
        style="@style/RectButtonStyle"
        android:id="@+id/btnTenseIntro"
        android:text="@string/tense_introduction"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"/>

    <!-- Present Tense Button -->
    <Button
        style="@style/RectButtonStyle"
        android:id="@+id/btnPresent"
        android:text="@string/present_tense"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnTenseIntro"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"/>

    <!-- Past Tense Button -->
    <Button
        style="@style/RectButtonStyle"
        android:id="@+id/btnPast"
        android:text="@string/past_tense"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/btnPresent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"/>

    <!-- Future Tense Button -->
    <Button
        style="@style/RectButtonStyle"
        android:id="@+id/btnFuture"
        android:text="@string/future_tense"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/btnPast"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"/>

    <!-- Tense Table Button -->
    <Button
        style="@style/RectButtonStyle"
        android:id="@+id/btnTenseTable"
        android:text="@string/tense_table"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/btnFuture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
