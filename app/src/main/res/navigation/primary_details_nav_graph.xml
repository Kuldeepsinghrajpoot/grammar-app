<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/grammaritems_list_fragment">

    <fragment
        android:id="@+id/grammaritems_list_fragment"
        android:name="com.example.grammar.GrammarItemsListFragment"
        android:label="GrammarItemsListFragment">
        <action
            android:id="@+id/show_grammaritems_detail"
            app:destination="@id/grammaritems_detail_fragment" />
    </fragment>
    <fragment
        android:id="@+id/grammaritems_detail_fragment"
        android:name="com.example.grammar.GrammarItemsDetailFragment"
        android:label="grammaritems_detail"
        tools:layout="@layout/fragment_grammaritems_detail">
        <argument
            android:name="item_id"
            android:defaultValue=""
            app:argType="string" />
    </fragment>
</navigation>